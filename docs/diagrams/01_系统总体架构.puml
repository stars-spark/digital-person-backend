@startuml 01_系统总体架构
!include _style.puml

top to bottom direction

package "① 游客端（多端）" as L1 {
  [手机网页 webapp\niOS HLS / 安卓 FLV]
  [安卓 APK（规划）]
}

package "② 接入层" as L2 {
  [桥接层 Bridge :9000]
}

package "③ 应用层 · RAG 后端 :8000" as L3 {
  [多智能体\nOrchestrator] as ORC
  [RAG 问答引擎\n混合检索+重排] as RAGE
  [情境感知\n人流/天气/时间] as CTX
  [多模态\n视觉定位] as VL
  [行程关怀\n迎宾/游记] as TRIP
}

package "④ 数字人渲染 · LiveTalking :8010" as L4 {
  [MuseTalk\n口型同步] as MT
  [情绪表情底座] as EMO
  [语音 ASR / TTS] as VOICE
}

package "⑤ 数据层" as L5 {
  database "ChromaDB\n5景区 collection" as CDB
  database "SQLite\n会话/事件/配置" as SDB
  database "行为数据集\n14万行 xlsx" as XDB
}

cloud "阿里云 DashScope\nqwen-plus / qwen-vl-max / embedding" as CLOUD

' —— 自上而下的请求主流 ——
L1 --> [桥接层 Bridge :9000]
[桥接层 Bridge :9000] --> ORC : 提问 (REST/SSE)
[桥接层 Bridge :9000] --> MT : 逐句文字驱动
ORC --> RAGE
RAGE --> CDB : 混合检索
CTX --> XDB
ORC --> SDB : 会话落库
RAGE ..> CLOUD : 生成/嵌入
VL ..> CLOUD : qwen-vl 认地标

' 布局约束：用隐藏边把层级压成自上而下
L1 -[hidden]-> L2
L2 -[hidden]-> L3
L3 -[hidden]-> L4
L4 -[hidden]-> L5
@enduml
